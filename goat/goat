#!/bin/sh
# Rust is the only Goat command implementation. Keep this stable repository
# entrypoint so existing `./goat/goat ...` workflows do not depend on Python.
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec cargo run --quiet --release --locked \
    --manifest-path "$repo/goat-rust/Cargo.toml" -- "$@"
