#!/usr/bin/env python3
"""goat launcher: `./goat/goat <command> ...`."""
import os
import sys

# The package lives in the parent of this launcher's directory, not in it.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from goat.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
